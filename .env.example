# Copy to .env (API) and keep VITE_* values available to Vite.
# Never put secrets in VITE_* — they are baked into the browser bundle.

# Postgres (Neon or local). Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/shopmatic?sslmode=require
# Optional pooled URL for serverless / pgbouncer
DATABASE_POOLED_URL=postgresql://USER:PASSWORD@HOST/shopmatic?sslmode=require&pgbouncer=true

# Server JWT. Required in production. Generate: openssl rand -base64 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
PORT=3001
FRONTEND_URL=http://localhost:8080

# Optional: AI Quick Add
VITE_OPENAI_API_KEY=

# Optional: transactional email (Emailit)
EMAILIT_API_KEY=
EMAILIT_FROM_EMAIL=notifications@shopmatic.cc
EMAILIT_FROM_NAME=Shopmatic

# App
NODE_ENV=development
VITE_ENV=development
VITE_APP_NAME=Shopmatic
VITE_APP_URL=http://localhost:8080
VITE_DOMAIN=shopmatic.cc
VITE_PRODUCTION_URL=https://shopmatic.cc

# Feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ADVANCED_FEATURES=false
VITE_ENABLE_EMAIL_NOTIFICATIONS=true
