{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "anthropic": {
      "options": {
        "apiKey": "${ANTHROPIC_API_KEY}",
        "baseURL": "https://bsanthiprakash-7735-resource.services.ai.azure.com/anthropic/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6 (Azure)",
          "limit": {
            "context": 200000,
            "output": 16384
          }
        }
      }
    },
    "azure-foundry": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure AI Foundry",
      "options": {
        "apiKey": "${AZURE_FOUNDRY_API_KEY}",
        "baseURL": "https://min-0172-resource.services.ai.azure.com/openai/v1"
      },
      "models": {
        "Kimi-K2.5": {
          "name": "Kimi K2.5 (Azure)",
          "limit": {
            "context": 262000,
            "output": 16384
          }
        },
        "DeepSeek-R1": {
          "name": "DeepSeek-R1 (Azure)",
          "tool_call": false,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "DeepSeek-V3.2": {
          "name": "DeepSeek-V3.2 (Azure)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "DeepSeek-V3.2-Speciale": {
          "name": "DeepSeek-V3.2-Speciale (Azure)",
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "start"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "sequentialthinking": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@modelcontextprotocol/server-sequential-thinking"
      ],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "cloudflare": {
      "type": "local",
      "command": ["npx", "@cloudflare/mcp-server-cloudflare@latest"],
      "enabled": false
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github@latest"],
      "enabled": false
    }
  }
}
