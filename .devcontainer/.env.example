# SPB Dev Container - API Keys
# Copy to .env and fill in your keys: cp .env.example .env
# NEVER commit .env to git
# ============================================================

# ============================================================
# AI MODEL PROVIDER KEYS (Organized by Provider)
# ============================================================

# --- Z.AI (GLM models) ---
# Endpoint: https://api.z.ai/api/coding/paas/v4
# Models: GLM-5.1, GLM-5, GLM-5 Turbo, GLM-4.7
ZAI_API_KEY=your-zai-api-key

# --- MiniMax ---
# Endpoint: https://api.minimax.io/v1
# Models: MiniMax M2.7
MINIMAX_API_KEY=your-minimax-api-key

# --- NVIDIA NIM (6 Free/Frontier Models) ---
# Endpoint: https://integrate.api.nvidia.com/v1
# Models: Kimi K2.5, Nemotron 3 Super, Qwen 3.5, Mistral Small 4, Step 3.5 Flash, Llama 3.2 Vision
NVIDIA_API_KEY=nvapi-your-nvidia-key

# --- Azure Kimi K2.5 (Segregated Rate Limiting) ---
# Endpoint: https://spb26-resource.services.ai.azure.com/openai/v1
# Model: Kimi-K2.5 (multimodal, coding, agentic)
# Note: Separate from DeepSeek for independent rate limit management
CLAUDE_AZURE_FOUNDRY_API_KEY=your-azure-kimi-api-key
CLAUDE_AZURE_FOUNDRY_BASE_URL=https://spb26-resource.services.ai.azure.com/openai/v1/

# --- Azure DeepSeek Models (Segregated Rate Limiting) ---
# Endpoint: https://min-0172-resource.openai.azure.com/openai/v1
# Models: DeepSeek V3.2, DeepSeek V3.2 Speciale, DeepSeek R1
# Note: Separate from Kimi for independent rate limit management
DEEPSEEK_AZURE_OPENAI_API_KEY=your-azure-deepseek-api-key
DEEPSEEK_AZURE_OPENAI_BASE_URL=https://min-0172-resource.openai.azure.com/openai/v1/

# ============================================================
# OPTIONAL: CLI Subscription & Service Keys
# ============================================================

# Opencode Go subscription (enables GLM, Minimax, Kimi via Opencode)
OPENCODE_GO_KEY=sk-your-opencode-go-key

# Kilo Code subscription (enables BYOK models via Kilo gateway)
KILO_API_KEY=your-kilo-jwt-token

# Brave Search (web search MCP server)
BRAVE_API_KEY=your-brave-search-api-key

# ============================================================
# PROJECT-SPECIFIC CONFIGURATION
# Add your app's secrets below. All vars here are automatically
# available as environment variables inside the container.
# ============================================================

# --- Database -------------------------------------------------
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# REDIS_URL=redis://localhost:6379

# --- Authentication -------------------------------------------
# JWT_SECRET=your-jwt-secret
# SESSION_SECRET=your-session-secret

# --- Email / SMTP ---------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# --- Cloud Services -------------------------------------------
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# CLOUDFLARE_ACCOUNT_ID=your-account-id
# CLOUDFLARE_API_TOKEN=your-cf-token
# R2_ACCESS_KEY_ID=your-r2-key
# R2_SECRET_ACCESS_KEY=your-r2-secret

# --- Payment --------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Third-Party APIs -----------------------------------------
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-key

# --- App Config -----------------------------------------------
# NODE_ENV=development
# PORT=3000
# VITE_API_URL=http://localhost:3001
